# Terraform: commit .terraform.lock.hcl, exclude runtime state and values
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tflock
*.tfvars
*.tfvars.json
*.tfbackend
override.tf
override.tf.json
*_override.tf
*_override.tf.json
crash.log
crash.*.log

# Credentials and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.ovpn
**/secrets/
**/credentials/

# Python and local files
.venv/
venv/
__pycache__/
*.pyc
.DS_Store
*.log
*.tmp
*.bak
.vscode/settings.json
